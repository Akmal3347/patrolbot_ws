<?xml version="1.0"?>
<sdf version="1.6">
  <world name="compact_random_arena">

    <light name='sun_manual' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver><type>quick</type><iters>150</iters><sor>1.4</sor></solver>
        <constraints><cfm>0.00001</cfm><erp>0.2</erp></constraints>
      </ode>
    </physics>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <model name='wall_n'><static>1</static><pose>0 3 1 0 0 0</pose><link name='l'><collision name='c'><geometry><box><size>6.2 0.2 2</size></box></geometry></collision><visual name='v'><geometry><box><size>6.2 0.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name='wall_s'><static>1</static><pose>0 -3 1 0 0 0</pose><link name='l'><collision name='c'><geometry><box><size>6.2 0.2 2</size></box></geometry></collision><visual name='v'><geometry><box><size>6.2 0.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name='wall_e'><static>1</static><pose>3 0 1 0 0 0</pose><link name='l'><collision name='c'><geometry><box><size>0.2 6.2 2</size></box></geometry></collision><visual name='v'><geometry><box><size>0.2 6.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name='wall_w'><static>1</static><pose>-3 0 1 0 0 0</pose><link name='l'><collision name='c'><geometry><box><size>0.2 6.2 2</size></box></geometry></collision><visual name='v'><geometry><box><size>0.2 6.2 2</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>

    <model name='obs_1'> <pose>-0.5 1.5 1 0 0 0</pose> <static>1</static> <link name='l'><collision name='c'><geometry><cylinder><radius>0.2</radius><length>2</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.2</radius><length>2</length></cylinder></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual></link></model>
    <model name='obs_2'> <pose>1.2 -1.0 1 0 0 0</pose> <static>1</static> <link name='l'><collision name='c'><geometry><cylinder><radius>0.2</radius><length>2</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.2</radius><length>2</length></cylinder></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual></link></model>
    <model name='obs_3'> <pose>-1.0 -2.0 1 0 0 0</pose> <static>1</static> <link name='l'><collision name='c'><geometry><cylinder><radius>0.2</radius><length>2</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.2</radius><length>2</length></cylinder></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual></link></model>
    <model name='obs_4'> <pose>2.0 2.0 1 0 0 0</pose> <static>1</static> <link name='l'><collision name='c'><geometry><cylinder><radius>0.2</radius><length>2</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.2</radius><length>2</length></cylinder></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual></link></model>
    <model name='obs_5'> <pose>0.2 0.1 1 0 0 0</pose> <static>1</static> <link name='l'><collision name='c'><geometry><cylinder><radius>0.2</radius><length>2</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.2</radius><length>2</length></cylinder></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual></link></model>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>4.0 -4.0 4.0 0 0.5 2.4</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>